PORT=4000
CLIENT_URL=http://localhost:5173
# Set this to the exact public website origin when using a tunnel or deployment.
PUBLIC_URL=http://localhost:5173
MONGODB_URI=mongodb+srv://<db_user>:<db_password>@<cluster-host>/college_complaints?retryWrites=true&w=majority
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=2h
OTP_SECRET=replace-with-a-different-long-random-secret
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
# SMTP is required in production. Local development uses a console/json mail transport when these are empty.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:4000/api/auth/google/callback
ADMIN_EMAIL=admin@campuscare.local
ADMIN_PASSWORD_HASH=
COOKIE_SECURE=false
